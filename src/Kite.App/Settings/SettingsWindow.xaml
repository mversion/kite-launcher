<Window x:Class="Kite.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kite Settings"
        Width="1000" Height="720" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource S.Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource S.Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,16">
                    <Image x:Name="Logo" Width="26" Height="26" Margin="0,0,10,0" />
                    <TextBlock Text="Kite" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource S.Faint}" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,3" />
                </StackPanel>

                <!-- Find-as-you-type -->
                <Grid DockPanel.Dock="Top" Margin="14,0,14,12">
                    <TextBox x:Name="SearchBox" Padding="32,7,28,7" Tag="Find a setting  (Ctrl+F)" TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource S.Icons}" FontSize="13" Foreground="{StaticResource S.SubText}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0" />
                    <Button x:Name="ClearSearch" Style="{StaticResource S.IconButton}" Content="&#xE711;" FontSize="10" Padding="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Visibility="Collapsed"
                            Click="ClearSearch_Click" ToolTip="Clear (Esc)" />
                </Grid>

                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="22,10,16,16" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource S.Faint}" />

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource S.NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Nav_SelectionChanged" />
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="36,26,36,30">
            <StackPanel x:Name="ContentPanel" MaxWidth="900" />
        </ScrollViewer>

        <!-- Toast for errors / confirmations -->
        <Border x:Name="Toast" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                Background="#333333" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="6" Padding="14,8" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" FontSize="12" />
        </Border>
    </Grid>
</Window>
