<UserControl x:Class="Kite.App.Settings.SkinPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <!-- A faithful, static copy of the launcher's visual tree, driven by the same resource keys. -->
    <Grid Margin="{DynamicResource Kite.ShadowMargin}" Width="{DynamicResource Kite.Width}">
        <Border CornerRadius="{DynamicResource Kite.CornerRadius}"
                Background="{DynamicResource Kite.Background}"
                BorderBrush="{DynamicResource Kite.BorderBrush}"
                BorderThickness="{DynamicResource Kite.BorderThickness}"
                Effect="{DynamicResource Kite.Shadow}">
            <Grid>
                <Border CornerRadius="{DynamicResource Kite.CornerRadius}" Background="{DynamicResource Kite.BackgroundImage}" />
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="{DynamicResource Kite.AccentWidth}" Background="{DynamicResource Kite.Accent}"
                            CornerRadius="{DynamicResource Kite.AccentCornerRadius}" />
                    <StackPanel>
                        <Border Background="{DynamicResource Kite.InputBackgroundImage}">
                            <Grid Height="{DynamicResource Kite.Input.Height}" Margin="{DynamicResource Kite.Input.Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Chip" Background="{DynamicResource Kite.Chip.Background}" CornerRadius="4" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="E-Mail" Foreground="{DynamicResource Kite.Chip.Foreground}" FontFamily="{DynamicResource Kite.Results.FontFamily}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text=" ›" Foreground="{DynamicResource Kite.Chip.Foreground}" Opacity="0.7" FontSize="13" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="InputText" Text="paint"
                                               FontFamily="{DynamicResource Kite.Input.FontFamily}" FontSize="{DynamicResource Kite.Input.FontSize}"
                                               FontWeight="{DynamicResource Kite.Input.FontWeight}" Foreground="{DynamicResource Kite.Input.Foreground}" />
                                    <Border Width="1.5" Margin="1,3" Background="{DynamicResource Kite.Input.Caret}" />
                                    <TextBlock x:Name="PlaceholderText" Text="{DynamicResource Kite.Placeholder.Text}" Visibility="Collapsed"
                                               FontFamily="{DynamicResource Kite.Input.FontFamily}" FontSize="{DynamicResource Kite.Input.FontSize}"
                                               FontWeight="{DynamicResource Kite.Input.FontWeight}" Foreground="{DynamicResource Kite.Placeholder.Foreground}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                           Foreground="{DynamicResource Kite.Glyph.Foreground}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Border>

                        <Border x:Name="ResultsPanel" Background="{DynamicResource Kite.Results.Background}" BorderBrush="{DynamicResource Kite.Separator}"
                                BorderThickness="0,1,0,0" Padding="0,5" CornerRadius="{DynamicResource Kite.ResultsCornerRadius}">
                            <ItemsControl x:Name="Rows" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
