<Window x:Class="Kite.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kite.App"
        Title="Kite Launcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Width="{DynamicResource Kite.WindowWidth}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Kite.Results.Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent"
                                CornerRadius="{DynamicResource Kite.Results.SelectionCornerRadius}"
                                Height="{DynamicResource Kite.Results.RowHeight}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Kite.Results.SelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Kite.Results.SelectedForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:ResultRow}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="{DynamicResource Kite.IconSize}" Height="{DynamicResource Kite.IconSize}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource Kite.Glyph.Foreground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource Kite.Results.FontFamily}"
                               FontSize="{DynamicResource Kite.Results.FontSize}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    <TextBlock x:Name="Desc" Text="{Binding Description}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                               FontFamily="{DynamicResource Kite.Results.FontFamily}"
                               FontSize="{DynamicResource Kite.Results.DescFontSize}"
                               Foreground="{DynamicResource Kite.Results.DescForeground}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" VerticalAlignment="Center" Margin="12,0,2,0"
                           FontFamily="{DynamicResource Kite.Results.FontFamily}" FontSize="10.5"
                           Foreground="{DynamicResource Kite.Shortcut.Foreground}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Desc" Property="Foreground" Value="{DynamicResource Kite.Results.SelectedDescForeground}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type local:Chip}">
            <Border Background="{DynamicResource Kite.Chip.Background}" CornerRadius="4" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Kite.Chip.Foreground}"
                               FontFamily="{DynamicResource Kite.Results.FontFamily}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text=" ›" Foreground="{DynamicResource Kite.Chip.Foreground}" Opacity="0.7" FontSize="13" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <ContextMenu x:Key="LauncherMenu" Style="{StaticResource KiteContextMenu}" Placement="MousePoint">
            <MenuItem x:Name="MenuPaste" Header="Paste" InputGestureText="Ctrl+V" Tag="&#xE77F;" />
            <Separator />
            <MenuItem x:Name="MenuRebuild" Header="Rebuild catalog" InputGestureText="F5" Tag="&#xE72C;" />
            <MenuItem x:Name="MenuReloadSkin" Header="Reload skin" InputGestureText="Shift+F5" Tag="&#xE790;" />
            <MenuItem x:Name="MenuSkins" Header="Skin" Tag="&#xE771;">
                <MenuItem Header="(loading)" />
            </MenuItem>
            <MenuItem x:Name="MenuOptions" Header="Options" InputGestureText="Ctrl+," Tag="&#xE713;" />
            <Separator />
            <MenuItem x:Name="MenuExit" Header="Exit" Tag="&#xE7E8;" />
        </ContextMenu>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Kite.Separator}" CornerRadius="3" Margin="1,2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="{DynamicResource Kite.ShadowMargin}">
        <Border x:Name="Frame"
                PreviewMouseLeftButtonDown="Frame_PreviewMouseLeftButtonDown"
                ContextMenu="{StaticResource LauncherMenu}"
                CornerRadius="{DynamicResource Kite.CornerRadius}"
                Background="{DynamicResource Kite.Background}"
                BorderBrush="{DynamicResource Kite.BorderBrush}"
                BorderThickness="{DynamicResource Kite.BorderThickness}"
                Effect="{DynamicResource Kite.Shadow}">
            <Grid>
                <!-- Optional skin image layer, clipped by the frame's rounded corners -->
                <Border CornerRadius="{DynamicResource Kite.CornerRadius}" Background="{DynamicResource Kite.BackgroundImage}" />

                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="{DynamicResource Kite.AccentWidth}"
                            Background="{DynamicResource Kite.Accent}"
                            CornerRadius="{DynamicResource Kite.AccentCornerRadius}" />

                    <StackPanel>
                        <!-- Input row (optional skin image behind it, e.g. a Launchy frame.png) -->
                        <Border Background="{DynamicResource Kite.InputBackgroundImage}">
                        <Grid x:Name="InputRow" Height="{DynamicResource Kite.Input.Height}" Margin="{DynamicResource Kite.Input.Padding}"
                              Background="Transparent" Cursor="SizeAll">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl x:Name="ChipList" ItemTemplate="{StaticResource ChipTemplate}" VerticalAlignment="Center" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock x:Name="Placeholder" Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"
                                       Text="{DynamicResource Kite.Placeholder.Text}"
                                       FontFamily="{DynamicResource Kite.Input.FontFamily}"
                                       FontSize="{DynamicResource Kite.Input.FontSize}"
                                       FontWeight="{DynamicResource Kite.Input.FontWeight}"
                                       Foreground="{DynamicResource Kite.Placeholder.Foreground}" />

                            <TextBox x:Name="Input" Grid.Column="1" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FontFamily="{DynamicResource Kite.Input.FontFamily}"
                                     FontSize="{DynamicResource Kite.Input.FontSize}"
                                     FontWeight="{DynamicResource Kite.Input.FontWeight}"
                                     Foreground="{DynamicResource Kite.Input.Foreground}"
                                     CaretBrush="{DynamicResource Kite.Input.Caret}"
                                     SelectionBrush="{DynamicResource Kite.Accent}"
                                     AcceptsTab="False" AcceptsReturn="False"
                                     FocusVisualStyle="{x:Null}"
                                     PreviewKeyDown="Input_PreviewKeyDown"
                                     TextChanged="Input_TextChanged" />

                            <!-- Spinner shown while the catalog rebuilds (like Launchy's) -->
                            <Path x:Name="Spinner" Grid.Column="2" Width="16" Height="16" Margin="12,0,0,0" Visibility="Collapsed"
                                  Stroke="{DynamicResource Kite.Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 8,1 A 7,7 0 1 1 1,8" RenderTransformOrigin="0.5,0.5" ToolTip="Rebuilding catalog…">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" />
                                </Path.RenderTransform>
                            </Path>

                            <Image x:Name="TopIcon" Grid.Column="3" Width="{DynamicResource Kite.IconSize}" Height="{DynamicResource Kite.IconSize}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        </Border>

                        <!-- Results -->
                        <Border x:Name="ResultsPanel" Visibility="Collapsed" Background="{DynamicResource Kite.Results.Background}"
                                BorderBrush="{DynamicResource Kite.Separator}" BorderThickness="0,1,0,0" Padding="0,5"
                                CornerRadius="{DynamicResource Kite.ResultsCornerRadius}">
                            <ListBox x:Name="Results"
                                     ItemTemplate="{StaticResource ResultTemplate}"
                                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewMouseLeftButtonUp="Results_PreviewMouseLeftButtonUp">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                                </ListBox.Resources>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
